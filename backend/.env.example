# HTTP server
PORT=5000
NODE_ENV=development

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=tour_guide
DB_PASSWORD=change-me
DB_NAME=multilingual_tour_guide

# Use a long, random value. Do not commit the real secret.
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated browser origins. Leave empty in local development to allow
# any browser origin; this value is required when NODE_ENV=production.
CORS_ORIGIN=http://localhost:5173,http://localhost:8081
